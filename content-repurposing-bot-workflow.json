      "name": "Code in JavaScript - Get Content"
    },
    {
      "parameters": {
        "jsCode": "const raw = $input.first().json.candidates[0].content.parts[0].text;\nconst cleaned = raw.replace(/```json|```/g, '').trim();\nconst parsed = JSON.parse(cleaned);\n\nreturn [\n  { json: { summary: parsed.summary, twitter: parsed.twitter, linkedin: parsed.linkedin } }\n];"
      },
