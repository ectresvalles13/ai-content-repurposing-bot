    {
      "parameters": {
        "jsCode": "const inputJson = $input.first().json;\nconst articleText = inputJson.data || inputJson[''] || Object.values(inputJson)[0];\n\nconst prompt = `You are a social media content assistant. Given the article text below, do three things: 1) Write a 2-sentence summary. 2) Write a Twitter/X caption (under 280 characters, engaging, with 1-2 relevant hashtags). 3) Write a LinkedIn caption (professional tone, 3-4 sentences, no hashtags). Respond ONLY with valid JSON in this exact format, no markdown, no extra text: {\"summary\": \"...\", \"twitter\": \"...\", \"linkedin\": \"...\"}\n\nArticle text: ${articleText}`;\n\nconst requestBody = {\n  contents: [\n    { parts: [ { text: prompt } ] }\n  ]\n};\n\nreturn [ { json: { requestBody: requestBody } } ];"
      },
